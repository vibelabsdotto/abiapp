{
  "name": "abiapp",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --port 8090",
    "ios": "expo run:ios --port 8090",
    "android": "expo run:android --port 8090",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint && npm run check:contrast && npm run check:menu-icons",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "type-check": "tsc --noEmit",
    "postinstall": "patch-package",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contrast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-contrast.mts",
    "icons:tabs": "node scripts/generate-tab-icons.mjs",
    "check:menu-icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-menu-icons.mts",
    "icons:android": "node scripts/generate-android-menu-icons.mjs"
  },
  "dependencies": {
    "@expo/ui": "~58.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-menu/menu": "2.0.0",
    "@vibelabsdotto/featurama-rn-expo": "^0.1.5",
    "@vibelabsdotto/vibeupdate": "0.4.0",
    "expo": "~58.0.15",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.24",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-store-review": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.22",
    "i18n-js": "^4.5.4",
    "lucide-react-native": "^1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-import-resolver-typescript": "3.10.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@vibelabsdotto/vibeupdate": {
      "expo": "$expo",
      "react-native": "$react-native",
      "expo-application": "$expo-application",
      "expo-localization": "$expo-localization"
    }
  }
}
