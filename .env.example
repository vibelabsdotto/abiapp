# Copy to .env.local and fill in. Both values are public in the app bundle.

# Public VibeUpdate app ID (app_…). Empty: the update/changelog prompt is not rendered.
EXPO_PUBLIC_VIBEUPDATE_APP_ID=

# Project-bound Featurama key. Empty: the feature request entry is hidden.
EXPO_PUBLIC_FEATURAMA_API_KEY=

# 1: Android shows the "Google Drive" switch of the cloud backup. Needs the
# Android OAuth client in the Google Cloud project (docs/release.md).
EXPO_PUBLIC_GOOGLE_DRIVE_ENABLED=
